# RootAccess Phase 1 Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
#
# IMPORTANT SECURITY RULES:
# 1. ONLY use your Supabase Project URL and the "anon" (public) key here.
# 2. NEVER put the "service_role" secret key into frontend code or .env files.
#    The service_role key bypasses all Row Level Security and must remain server-side only.

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Client-Safe Anon/Public Key (starts with eyJ...)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
